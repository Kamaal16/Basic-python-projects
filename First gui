#Creating my first gui
import sys
import PyQt5
from PyQt5.QtWidgets import QApplication, QMainWindow
class Mainwindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("My First Gui")

def main():
    app = QApplication(sys.argv)
    window = Mainwindow()
    window.show()
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
