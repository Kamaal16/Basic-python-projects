#Case
case = input("Convert celsius to fahrenheit or Farenheit to Celsius: ")

#Case 1 ( Cel to Far )
if case == "CtoF" :
    data_c = int(input("Enter temperature in Celsius: "))
    ctof = data_c * 9/5 + 32
    print(f'The celsius converted to farenheit is : {ctof}')

#Case 2 ( Far to Cel )
elif case == "FtoC" :
    data_f = int(input("Enter temperature in Farenheit: "))
    ftoc = (data_f - 32) / 1.8
    print(f'The farenheit converted to Celsius is : {ftoc}')

#Invalid Input
else :
    print("Invalid input")
